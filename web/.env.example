# Copie este arquivo para `.env.local` e preencha com os valores do SEU projeto
# Supabase (Dashboard > Project Settings > API). `.env.local` e ignorado pelo
# git (regra `*.local` no web/.gitignore) — nunca commite as chaves.
#
#   cp .env.example .env.local
#
# Onde achar cada valor no dashboard:
#   Project URL  -> "Project URL"
#   anon key     -> "Project API keys" > `anon` `public`

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# ATENCAO: a `service_role` key NAO entra aqui e NUNCA entra em web/.
# Tudo que tem prefixo VITE_ vai para dentro do bundle que roda no navegador —
# qualquer jogador consegue ler. A service_role ignora RLS por completo, entao
# expo-la daria a qualquer um acesso total ao banco.
# Ela vive so na raiz do repo (.env, tambem gitignored), usada pelos scripts de
# build/migracao de catalogo e, na Fase D, pelo servidor Node.
