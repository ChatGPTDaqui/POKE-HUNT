{
  "name": "novo-poke-idle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copiar-assets.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "serve": "node serve.js",
    "start": "npm run build && node serve.js",
    "db:types": "npx supabase gen types typescript --linked > src/lib/database.types.ts",
    "test": "vitest run",
    "build:engine": "vite build --config vite.engine.config.ts && tsc -p tsconfig.app.json --declaration --emitDeclarationOnly --noEmit false --rootDir src --outDir server/engine/types",
    "build:edge": "vite build --config vite.edge.config.ts",
    "catalog:gerar": "node scripts/generate-catalog.js",
    "catalog:migrar": "node scripts/migrate-catalog-to-postgres.js",
    "catalog:verificar": "node scripts/verify-catalog-diff.js",
    "planilha:aplicar": "node scripts/sync-planilha.js",
    "db:wipe": "node scripts/wipe-todos-os-saves.js",
    "edge:publicar": "npm run build:edge && npx supabase functions deploy jogo"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "immer": "^11.1.16",
    "lucide-react": "^1.29.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
