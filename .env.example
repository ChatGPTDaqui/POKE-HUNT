# Copie para `.env` (ignorado pelo git) e preencha. Este arquivo e da RAIZ do
# repo e serve aos scripts de build/migracao de catalogo — nao ao app do
# navegador (esse usa web/.env.local, com outras chaves).
#
# Dashboard > Project Settings > API

SUPABASE_URL=https://cffbihbmhiuudahsgjsn.supabase.co

# --- Credenciais da CLI (so necessarias se voce NAO rodou `supabase login`
# num terminal de verdade) ---
#
# Personal Access Token: https://supabase.com/dashboard/account/tokens
# A CLI le esta variavel automaticamente e dispensa o login interativo.
SUPABASE_ACCESS_TOKEN=

# Senha do banco (a definida ao criar o projeto, NAO a senha da sua conta).
# Esqueceu? Project Settings > Database > Reset database password.
SUPABASE_DB_PASSWORD=

# `service_role` key. Ignora RLS por completo — e a chave de administrador do
# banco. So usada por script rodando na sua maquina / no servidor. Se ela
# aparecer em qualquer coisa servida ao navegador, o banco esta comprometido.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui
