---
import Base from '../layouts/Base.astro'
import MiniHunt from './MiniHunt.astro'
import { GAME_URL, SITE_URL, spriteUrl, trainerUrl, sceneUrl, biomeUrl } from '../config.mjs'
import { ROUTES, UI } from '../i18n.mjs'

interface Props { lang: 'pt' | 'en' }
const { lang } = Astro.props
const t = UI[lang]
const pt = lang === 'pt'

const C = pt
  ? {
      title: 'Poke Inspiration — jogo idle de captura e batalha grátis no navegador',
      description:
        'Jogo de fã grátis no navegador: escolha seu inicial, cace em 12 biomas, capture shinies e evolua sua equipe com batalha automática. Sem download, no PC e no celular.',
      eyebrow: 'Idle de captura · grátis no navegador',
      lead: 'Seu time anda pelo mapa e luta sozinho. Você escolhe onde caçar, quem evoluir e o que fazer com cada captura.',
      how: 'Como funciona',
      facts: ['Sem download', 'PC e celular', 'Conta grátis'],
      journeyEyebrow: 'Primeiros passos',
      journeyTitle: 'Do inicial à primeira captura',
      prof: 'Prof. Carvalho',
      steps: [
        ['Crie sua conta', 'Leva menos de um minuto, e o jogo abre direto no navegador.'],
        ['Escolha Bulbasaur, Charmander ou Squirtle', 'Seu inicial vai direto para a Rota 46, feita para quem está começando.'],
        ['Deixe a caçada rodar', 'Enquanto o jogo está aberto, ele luta, ganha EXP e — com a auto-captura ligada — enche sua Pokédex.'],
      ],
      biomesEyebrow: 'O mundo',
      biomesTitle: '12 biomas para caçar',
      biomesText: 'Cada bioma tem suas espécies, estágios, salas e chefes. Arraste para o lado para conhecer.',
      biomes: ['Campo Aberto', 'Mata', 'Marinho', 'Águas Interiores', 'Áridos', 'Subterrâneo', 'Gélido', 'Ígneo', 'Urbano', 'Industrial', 'Sombrio', 'Sagrado'],
      featEyebrow: 'Por dentro do jogo',
      featTitle: 'Idle, mas com escolhas de verdade',
      featLead: 'Nada de clicar mil vezes: as automações cuidam de poção, status, captura e revive. Seu trabalho é montar a equipe certa para cada lugar.',
      feats: [
        ['pikachu', 'Batalha automática', 'O POKE em campo escolhe o golpe de maior dano contra cada alvo e prefere golpes em área quando acertam vários.'],
        ['eevee', 'Captura e shinies', 'Centenas de espécies, raridades até Mítico e shinies que viram alvo prioritário na hora.'],
        ['gyarados', 'Chefes e Modo Pesadelo', 'Cada bioma esconde chefes de sala, clima próprio e um modo bem mais difícil para quem quer desafio.'],
        ['dragonite', 'Mercado e PvP', 'Negocie itens e POKEs com outros jogadores, dispute o ranking e enfrente outros treinadores.'],
      ],
      chalEyebrow: 'Desafios',
      chalTitle: 'Ginásios, rivais e o Campeão Lance',
      chalText: 'Quando a equipe estiver pronta, os líderes de ginásio esperam. No fim do caminho, o Campeão.',
      boss: 'Campeão',
      ctaTitle: 'Pronto para a primeira caçada?',
      ctaText: 'É grátis, roda no navegador e o seu inicial já está esperando.',
    }
  : {
      title: 'Poke Inspiration — free idle catching & battle game in your browser',
      description:
        'Free fan-made browser game: pick your starter, hunt across 12 biomes, catch shinies and grow your team with automatic battles. No download, on PC and mobile.',
      eyebrow: 'Idle catching game · free in your browser',
      lead: 'Your team roams the map and fights on its own. You choose where to hunt, who to evolve and what to do with every catch.',
      how: 'How it works',
      facts: ['No download', 'PC and mobile', 'Free account', 'Game in Portuguese'],
      journeyEyebrow: 'First steps',
      journeyTitle: 'From starter to first catch',
      prof: 'Prof. Oak',
      steps: [
        ['Create your account', 'It takes under a minute, and the game opens right in your browser.'],
        ['Pick Bulbasaur, Charmander or Squirtle', 'Your starter heads straight to Route 46, made for beginners.'],
        ['Let the hunt run', 'While the game is open it fights, earns EXP and — with auto-catch on — fills your Pokédex.'],
      ],
      biomesEyebrow: 'The world',
      biomesTitle: '12 biomes to hunt in',
      biomesText: 'Each biome has its own species, stages, rooms and bosses. Swipe sideways to explore.',
      biomes: ['Open Fields', 'Woods', 'Ocean', 'Inland Waters', 'Badlands', 'Underground', 'Frozen', 'Volcanic', 'Urban', 'Industrial', 'Shadow', 'Sacred'],
      featEyebrow: 'Inside the game',
      featTitle: 'Idle, with real choices',
      featLead: 'No clicking a thousand times: automations handle potions, status, catching and revives. Your job is building the right team for each place.',
      feats: [
        ['pikachu', 'Automatic battles', 'Your POKE picks the highest-damage move for each target and prefers area moves when they hit several.'],
        ['eevee', 'Catching and shinies', 'Hundreds of species, rarities up to Mythical, and shinies that instantly become the priority target.'],
        ['gyarados', 'Bosses and Nightmare Mode', 'Every biome hides room bosses, its own weather and a much harder mode for those who want a challenge.'],
        ['dragonite', 'Market and PvP', 'Trade items and POKEs with other players, climb the ranking and face other trainers.'],
      ],
      chalEyebrow: 'Challenges',
      chalTitle: 'Gyms, rivals and Champion Lance',
      chalText: 'Once your team is ready, the gym leaders are waiting. At the end of the road, the Champion.',
      boss: 'Champion',
      ctaTitle: 'Ready for your first hunt?',
      ctaText: "It's free, runs in your browser, and your starter is already waiting.",
    }

const biomeIds = ['campo_aberto', 'mata', 'marinho', 'aguas_interiores', 'aridos', 'subterraneo', 'gelido', 'igneo', 'urbano', 'industrial', 'sombrio', 'sagrado']
const trainers = [
  ['brock', 'Brock'], ['misty', 'Misty'], ['erika', 'Erika'], ['sabrina', 'Sabrina'], ['blaine', 'Blaine'], ['red', 'Red'],
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['VideoGame', 'WebApplication'],
  name: 'Poke Inspiration',
  url: new URL(ROUTES.home[lang], SITE_URL).href,
  description: C.description,
  image: new URL('/og-image.png', SITE_URL).href,
  genre: ['Idle', 'RPG'],
  inLanguage: 'pt-BR',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web browser',
  gamePlatform: 'Web browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL', url: `${GAME_URL}/registro` },
}
const hero = sceneUrl('plains')
---

<Base lang={lang} page="home" title={C.title} description={C.description} jsonLd={jsonLd} preload={hero}>
  <section class="hero" style={`background-image:url(${hero})`}>
    <div class="wrap">
      <div class="frame dialog">
        <p class="eyebrow">{C.eyebrow}</p>
        <h1>Poke Inspiration</h1>
        <p class="lead">{C.lead}</p>
        <div class="ctas">
          <a class="btn" href={`${GAME_URL}/registro`}><span class="ball" aria-hidden="true"></span>{t.play}</a>
          <a class="btn alt" href={ROUTES.howto[lang]}>{C.how}</a>
        </div>
        <ul class="facts">{C.facts.map((f) => <li>{f}</li>)}</ul>
        <span class="next" aria-hidden="true"></span>
      </div>
      <MiniHunt lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap journey">
      <div class="prof">
        <img class="sprite" src={trainerUrl('oak')} alt="" width="160" height="160" />
        <span>{C.prof}</span>
      </div>
      <div>
        <p class="eyebrow">{C.journeyEyebrow}</p>
        <h2>{C.journeyTitle}</h2>
        <ol class="steps">
          {
            C.steps.map(([title, text], i) => (
              <li>
                <span class="num">{i + 1}</span>
                <div class="frame">
                  <h3>{title}</h3>
                  <p>{text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="biome-head">
        <div>
          <p class="eyebrow">{C.biomesEyebrow}</p>
          <h2>{C.biomesTitle}</h2>
        </div>
        <p>{C.biomesText}</p>
      </div>
      <div class="biomes" tabindex="0" aria-label={C.biomesTitle}>
        {
          biomeIds.map((id, i) => (
            <figure class="frame biome">
              <img src={biomeUrl(id)} alt="" width="640" height="853" loading="lazy" />
              <figcaption>
                {C.biomes[i]} <small>{String(i + 1).padStart(2, '0')}</small>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap features">
      <div>
        <p class="eyebrow">{C.featEyebrow}</p>
        <h2>{C.featTitle}</h2>
        <p class="lead">{C.featLead}</p>
      </div>
      <ul class="feat-list">
        {
          C.feats.map(([sprite, title, text]) => (
            <li>
              <img class="sprite" src={spriteUrl(sprite)} alt="" width="76" height="76" loading="lazy" />
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section challenge" style={`background-image:url(${sceneUrl('tall-grass', 900)})`}>
    <div class="wrap">
      <p class="eyebrow" style="color:var(--gold)">{C.chalEyebrow}</p>
      <h2>{C.chalTitle}</h2>
      <p>{C.chalText}</p>
      <div class="trainers">
        {
          trainers.map(([id, name]) => (
            <figure>
              <img class="sprite" src={trainerUrl(id)} alt="" width="96" height="96" loading="lazy" />
              <figcaption>{name}</figcaption>
            </figure>
          ))
        }
        <figure class="boss">
          <img class="sprite" src={trainerUrl('lance')} alt="" width="136" height="136" loading="lazy" />
          <figcaption>{C.boss} Lance</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="cta" style={`background-image:url(${sceneUrl('beach', 900)})`}>
    <div class="wrap">
      <div class="frame">
        <div class="row">
          <img class="sprite" src={spriteUrl('squirtle')} alt="" width="96" height="96" loading="lazy" />
          <div style="flex:1;min-width:220px">
            <h2 style="margin-bottom:.2em">{C.ctaTitle}</h2>
            <p>{C.ctaText}</p>
            <a class="btn" href={`${GAME_URL}/registro`}><span class="ball" aria-hidden="true"></span>{t.play}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
