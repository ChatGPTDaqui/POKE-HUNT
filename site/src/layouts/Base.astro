---
import '@fontsource-variable/pixelify-sans'
import '@fontsource/atkinson-hyperlegible/400.css'
import '@fontsource/atkinson-hyperlegible/700.css'
import '../styles.css'
import { SITE_URL, GAME_URL } from '../config.mjs'
import { ROUTES, UI } from '../i18n.mjs'

interface Props {
  lang: 'pt' | 'en'
  page: keyof typeof ROUTES
  title: string
  description: string
  jsonLd?: Record<string, unknown>
  preload?: string
}

const { lang, page, title, description, jsonLd, preload } = Astro.props
const t = UI[lang]
const pair = ROUTES[page]
const canonical = new URL(pair[lang] ?? pair.pt, SITE_URL).href
const other = lang === 'pt' ? 'en' : 'pt'
const otherHref = pair[other] ?? ROUTES.home[other]
const navIds = Object.keys(ROUTES) as (keyof typeof ROUTES)[]
const ogImage = new URL('/og-image.png', SITE_URL).href
const year = new Date().getFullYear()
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Verificação do Google Search Console (ver index.html do jogo). Remover desfaz a verificação. */}
    <meta name="google-site-verification" content="dn0iuu5wJcGRs31kNptcX1s6aqDvLkqpDbjsOfSd2U4" />
    {pair.pt && <link rel="alternate" hreflang="pt-BR" href={new URL(pair.pt, SITE_URL).href} />}
    {pair.en && <link rel="alternate" hreflang="en" href={new URL(pair.en, SITE_URL).href} />}
    <link rel="alternate" hreflang="x-default" href={new URL(pair.pt, SITE_URL).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f5ecd5" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Poke Inspiration" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={ROUTES.home[lang]}><span class="ball" aria-hidden="true"></span>Poke Inspiration</a>
        <nav aria-label="Menu">
          {
            navIds.map((id) => {
              const href = ROUTES[id][lang] ?? ROUTES[id].pt
              return (
                <a href={href} aria-current={id === page ? 'page' : undefined}>
                  {t.nav[id]}
                </a>
              )
            })
          }
          <a class="lang" href={otherHref} hreflang={other === 'pt' ? 'pt-BR' : 'en'}>{t.switchLabel}</a>
        </nav>
        <a class="btn small" href={`${GAME_URL}/registro`}>{t.play}</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <div>
          <a class="brand" href={ROUTES.home[lang]}><span class="ball" aria-hidden="true"></span>Poke Inspiration</a>
          <p>{t.footerNote}</p>
          <p>{t.disclaimer}</p>
          <p>© {year} Poke Inspiration</p>
        </div>
        <nav aria-label={lang === 'pt' ? 'Rodapé' : 'Footer'}>
          {navIds.map((id) => <a href={ROUTES[id][lang] ?? ROUTES[id].pt}>{t.nav[id]}</a>)}
          <a href={`${GAME_URL}/registro`}>{t.play}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
