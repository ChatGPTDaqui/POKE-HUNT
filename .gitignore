# Claude Code session data - not part of the game.
# settings.json E versionado de proposito (regra de time, ex: pedir confirmacao
# antes de mexer no schema do Supabase) — so o resto da pasta fica de fora.
.claude/*
!.claude/settings.json

# scripts/seed-species-moves-usum.mjs: pasta temporaria pra construir o
# bundle de ABILITIES/BASIC_ATTACK (precisa estar dentro do projeto pra
# `vite build` resolver o proprio node_modules) — apagada no fim do script,
# mas cai aqui como rede de seguranca se o script morrer no meio.
.seed-tmp-*/

# Rede de seguranca: a arte do jogo e servida por um plugin do Vite direto de
# assets/ na raiz (ver web/vite.config.ts), NAO por copia/link dentro de
# web/public. Se alguem recriar essa pasta por engano, o git seguiria e
# duplicaria ~6.300 arquivos (270MB) que ja estao versionados em assets/.
web/public/assets/

# CLAUDE.md agora e versionado (regra de time). CLAUDE.local.md e pessoal —
# hoje so a referencia ao vault Obsidian de cada dev, nao serve pro resto do time.
CLAUDE.local.md
# Backups manuais de CLAUDE*.md. ~300KB cada, ninguem quer commitar por acidente.
CLAUDE.md.backup-*
CLAUDE.local.md.backup-*

# Unused source-art leftovers: already consumed by import scripts / superseded
# by generated assets, never referenced at runtime (see CLAUDE.md history).
assets/SpriteCollab-master (1)/
assets/sprites.zip
assets/48056.png
assets/48057.png
assets/48064.png
assets/48065.png
assets/64891.png
assets/DS _ DSi - Pokemon Black 2 _ White 2 - Miscellaneous - HP Bars.png
assets/Design sem nome.png
assets/Design sem nome (1).png
assets/Design sem nome (1) (1).png
assets/Gemini_Generated_Image_.png
assets/Hunt background/
assets/Nintendo Switch - Pokemon Scarlet _ Violet - UI Elements - Item Icons/
assets/grass background medio.png
assets/hp-bar/
assets/move sprites/

# Segredos. O `.env` da raiz guarda a SUPABASE_SERVICE_ROLE_KEY, usada pelos
# scripts de catalogo (e, na Fase D, pelo servidor Node). Essa chave ignora RLS
# por completo — vazar equivale a dar acesso total ao banco. Nunca commitar.
.env
.env.*
!.env.example

# Copia local dos .asm que `scripts/derive-spawn-tiers.js` baixa dos
# disassemblies pret/*. Serve so pra rerodar a derivacao sem bater na rede de
# novo — o resultado (`scripts/spawn-tiers.json`) e que e versionado.
.cache/

# OS/editor cruft
.DS_Store
Thumbs.db

# LibreOffice/Excel lock file, created while the spreadsheet is open and
# deleted on close — never part of the project.
.~lock.*#

# --- vindas do antigo web/.gitignore (o app agora e a raiz) ---
node_modules
dist
dist-ssr
dist-engine/
*.local
logs
*.log
npm-debug.log*
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Imagens de conferencia do walk-block (scripts/conferir-walk-block.mjs) — 15MB de
# diagnostico regeravel, nao versionado.
scripts/body-block-refs/_conferencia/
scripts/agua-debug/
scripts/agua-refs/*-rascunho.png
scripts/lava-debug/

# Notas de operacao de maquina, geradas durante faxina de repositorio: a copia
# local do ruleset da dev (pra conferir protecao sem abrir o GitHub) e a lista
# de branch apagada com o hash pra restaurar. Nao sao do produto, e ficavam na
# raiz sem rastreamento E sem ignore — um `git add -A` distraido commitava as
# tres. Mesmo defeito que a PH-108 corrigiu pro tsbuildinfo. (PH-163)
dev-ruleset.json
branches-apagadas-*.txt

# Artefato de build do `tsc -b` em authority/ (PH-108). Ele reaparece a cada
# `npm run build:engine` + `tsc -b` la dentro, e sem esta linha um `git add -A`
# distraido o commita — 200KB de cache de compilacao que nao serve pra ninguem
# em outra maquina.
authority/tsconfig.tsbuildinfo
scripts/.gerado/
